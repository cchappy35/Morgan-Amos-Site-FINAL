# Cloudflare Pages header rules.

# Self-hosted fonts never change once published.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Photos change only when replaced.
/uploads/*
  Cache-Control: public, max-age=604800

# Always re-check the pages and the feed script, so a new deploy or a
# new listing shows up immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/feeds.js
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
